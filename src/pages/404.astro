---
import Layout from '../layouts/Layout.astro'
import styles from '../styles/blog.module.css'
---

<Layout title="Page not found" description="This page could not be found. Head back to the blog or the homepage." path="/404">
  <div slot="main" class={styles.main}>
    <h2>Page not found</h2>
    <p>This post does not exist, or it has moved.</p>
    <p>
      <a href="/blog/">Back to the blog</a> &middot; <a href="/">Go to the homepage</a>
    </p>
  </div>

  <div slot="aside" class={styles.aside}></div>
</Layout>
