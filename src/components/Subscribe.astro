<section class="subscribe">
  <p>Get my thoughts and notes in your inbox.</p>
  <button class="ml-onclick-form" type="button" onclick="ml('show', 'yFHhKP', true)">
    Subscribe
  </button>
</section>

<style>
  .subscribe {
    margin: 2.5rem 0 1.5rem;
    padding: 1.5rem 0 0;
    border-top: 1px solid #ddd;
    text-align: center;
  }
  .subscribe p {
    margin: 0 0 0.75rem;
  }
  .subscribe button {
    padding: 0.75rem 1.75rem;
    border: 0;
    border-radius: var(--radius);
    background: #14110d;
    color: #f3ead7;
    font: inherit;
    cursor: pointer;
  }
  .subscribe button:hover {
    background: #c9a24d;
    color: #14110d;
  }
</style>